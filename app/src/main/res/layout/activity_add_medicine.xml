<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/textViewAddMedTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_medicine"
            android:textColor="@color/medical_blue"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <EditText
            android:id="@+id/editMedName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/medicine_name"
            android:inputType="text" />

        <EditText
            android:id="@+id/editMedDosage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/dosage"
            android:inputType="text"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/txtMedDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="@string/date"
            android:background="@android:drawable/edit_text"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/txtMedTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="@string/time"
            android:background="@android:drawable/edit_text"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/editMedNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/notes"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reminder_date"
            android:textColor="@color/medical_blue"
            android:layout_marginTop="24dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtRemDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="@string/reminder_date"
            android:background="@android:drawable/edit_text"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/txtRemTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="@string/reminder_time"
            android:background="@android:drawable/edit_text"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/btnSaveMed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save"
            android:layout_marginTop="32dp"
            android:backgroundTint="@color/medical_blue" />

    </LinearLayout>
</ScrollView>